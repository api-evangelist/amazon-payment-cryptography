              "raw": "{\n  \"KeyIdentifier\": \"alias/BPZ2OUw\",\n  \"DeleteKeyInDays\": \"<integer>\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
