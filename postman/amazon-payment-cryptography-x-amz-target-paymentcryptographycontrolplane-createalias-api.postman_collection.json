            "body": {
              "mode": "raw",
              "raw": "{\n  \"AliasName\": \"alias/DbVTq\",\n  \"KeyArn\": \"arn:aws:payment-cryptography:jm-ans-711052503:825954731331:key/MgmKKxts5aIIekGAuOSJfH5HU2ButTEDeTn6196JWe4rGt\"\n}",
